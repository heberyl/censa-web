---
import Layout from '../layouts/Layout.astro';
import { services } from '../data/services';
---

<Layout
  title="Servicios Eléctricos de Media Tensión en Nuevo León"
  description="Instalación de redes MT, subestaciones eléctricas industriales, mantenimiento preventivo, emergencias 24/7 e ingeniería eléctrica en Nuevo León. Contratista homologado CFE y NOM-001-SEDE."
  image="/images/hero-servicios.jpg"
  heroImage="/images/hero-servicios.jpg"
  ogImageAlt="Instalación de redes eléctricas de media tensión en zona industrial"
  breadcrumbs={[{ name: 'Servicios', url: '/servicios' }]}
  pageSchema={{
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Servicios eléctricos CENSA',
    itemListElement: services.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'Service',
        name: s.title,
        description: s.description,
        provider: { '@type': 'LocalBusiness', name: 'CENSA', '@id': 'https://censa.com.mx/#organization' },
        areaServed: { '@type': 'State', name: 'Nuevo León' },
        url: `https://censa.com.mx/servicios/${s.slug}`,
      },
    })),
  }}
>
  <!-- Hero -->
  <section class="relative overflow-hidden min-h-[480px] md:h-[580px]" aria-label="Servicios — Portada">
    <img
      src="/images/hero-servicios.jpg"
      alt="Instalación de redes eléctricas de media tensión en zona industrial"
      width="1920" height="1080"
      class="absolute inset-0 h-full w-full object-cover"
      loading="eager"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/55 to-black/20"></div>
    <div class="relative z-10 mx-auto flex h-full max-w-[1400px] flex-col justify-center px-6 py-14 md:py-20 md:px-10">
      <div class="inline-flex items-center gap-3 mb-6">
        <span class="h-px w-8 bg-[#E10600]"></span>
        <span class="text-xs font-medium uppercase tracking-[0.24em] text-white/80">Lo que hacemos</span>
      </div>
      <h1 class="font-sans font-black text-4xl leading-tight tracking-[-0.03em] text-white md:text-6xl lg:text-7xl max-w-2xl">
        SERVICIOS<br /><span class="text-[#E10600]">ELÉCTRICOS</span><br />INDUSTRIALES
      </h1>
    </div>
  </section>

  <!-- Services list -->
  <div class="bg-[#F3EFEA]">
    {services.map(({ id, slug, num, title, subtitle, description, features, image }, i) => (
      <section
        id={id}
        class:list={['py-12 md:py-20', i % 2 === 0 ? 'bg-[#F3EFEA]' : 'bg-white']}
        aria-labelledby={`service-${id}-heading`}
      >
        <div class="mx-auto max-w-[1400px] px-6 md:px-10">
          <div class:list={['grid grid-cols-1 gap-8 md:grid-cols-2 md:gap-20 items-center reveal', i % 2 !== 0 ? 'md:[direction:rtl]' : '']}>
            <div class:list={[i % 2 !== 0 ? 'md:[direction:ltr]' : '']}>
              <div class="inline-flex items-center gap-3 mb-4">
                <span class="h-px w-8 bg-[#E10600]"></span>
                <span class="text-xs font-semibold uppercase tracking-[0.24em] text-[#E10600]">Servicio {num} / 05</span>
              </div>
              <h2 id={`service-${id}-heading`} class="font-sans font-black text-3xl leading-tight tracking-[-0.02em] text-[#111] md:text-4xl lg:text-5xl">
                {title.toUpperCase()}
              </h2>
              <p class="mt-2 text-sm font-semibold uppercase tracking-wider text-[#6D6D6D]">{subtitle}</p>
              <p class="mt-6 text-base leading-relaxed text-[#3a3a3a]">{description}</p>

              <ul class="mt-6 grid grid-cols-1 gap-2 sm:grid-cols-2">
                {features.map((feat) => (
                  <li class="flex items-center gap-2.5 text-sm text-[#3a3a3a]">
                    <span class="grid h-4 w-4 shrink-0 place-items-center rounded-full bg-[#E10600] text-white">
                      <svg xmlns="http://www.w3.org/2000/svg" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M20 6 9 17l-5-5"/>
                      </svg>
                    </span>
                    {feat}
                  </li>
                ))}
              </ul>

              <div class="mt-8 flex flex-wrap items-center gap-4">
                <a
                  href="/contacto"
                  class="inline-flex items-center gap-2 rounded-full bg-[#E10600] px-6 py-3 text-sm font-semibold text-white shadow-[0_8px_24px_-8px_rgba(225,6,0,0.5)] transition-all hover:bg-[#B30500] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#E10600] focus-visible:ring-offset-2"
                >
                  Solicitar cotización
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
                  </svg>
                </a>
                <a href={`/servicios/${slug}`} class="text-sm font-semibold text-[#6D6D6D] hover:text-[#E10600] transition-colors">
                  Ver página completa →
                </a>
              </div>
            </div>

            <div class:list={[i % 2 !== 0 ? 'md:[direction:ltr]' : '']}>
              <img
                src={image}
                alt={`${title} — servicio eléctrico de media tensión en Nuevo León por CENSA`}
                width="800" height="600"
                class="rounded-2xl object-cover w-full aspect-[4/3] shadow-[0_8px_40px_-12px_rgba(0,0,0,0.2)]"
                loading="lazy"
              />
            </div>
          </div>
        </div>
      </section>
    ))}
  </div>

  <!-- CTA -->
  <section class="bg-[#E10600] py-16 md:py-20">
    <div class="mx-auto max-w-[1400px] px-6 md:px-10 text-center">
      <h2 class="font-sans font-black text-3xl text-white md:text-4xl">¿NECESITAS UN SERVICIO ESPECÍFICO?</h2>
      <p class="mt-4 text-white/80 max-w-xl mx-auto">Cuéntanos tu proyecto y te preparamos una propuesta técnica sin costo en 48 horas.</p>
      <a href="/contacto" class="mt-8 inline-flex items-center gap-2 rounded-full bg-white px-8 py-4 text-sm font-semibold text-[#E10600] transition-all hover:bg-[#F3EFEA] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-[#E10600]">
        Solicitar cotización
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
        </svg>
      </a>
    </div>
  </section>
</Layout>
