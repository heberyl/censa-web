---
import Layout from '../layouts/Layout.astro';
import { cities } from '../data/cities';
import { services } from '../data/services';

export function getStaticPaths() {
  return cities.map((c) => ({
    params: { city: c.slug },
    props: { city: c },
  }));
}

const { city } = Astro.props;

const featuredServices = services.slice(0, 3);

const citySchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': 'https://censa.com.mx/#organization',
  name: 'CENSA',
  description: city.metaDescription,
  url: `https://censa.com.mx/${city.slug}`,
  telephone: '+528122358545',
  email: 'admon@censa.mx',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'San Isaac 1201, Residencial San Cristobal 3er Sector',
    addressLocality: 'San Nicolás de los Garza',
    addressRegion: 'Nuevo León',
    postalCode: '66478',
    addressCountry: 'MX',
  },
  areaServed: {
    '@type': 'City',
    name: city.name,
    containedIn: { '@type': 'State', name: 'Nuevo León' },
  },
};
---

<Layout
  title={city.titleSeo}
  description={city.metaDescription}
  image={city.image}
  heroImage={city.image}
  ogImageAlt={city.imageAlt}
  breadcrumbs={[{ name: city.name, url: `/${city.slug}` }]}
  pageSchema={citySchema}
>
  <!-- Hero -->
  <section class="relative overflow-hidden min-h-[420px] md:h-[500px]" aria-label={`Servicios eléctricos en ${city.name}`}>
    <img
      src={city.image}
      alt={city.imageAlt}
      width="1920" height="1080"
      class="absolute inset-0 h-full w-full object-cover"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-black/85 via-black/65 to-black/30"></div>
    <div class="relative z-10 mx-auto flex h-full max-w-[1400px] flex-col justify-center px-6 py-14 md:py-20 md:px-10">
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex items-center gap-2 text-xs text-white/50">
          <li><a href="/" class="hover:text-white transition-colors">Inicio</a></li>
          <li aria-hidden="true"><span>/</span></li>
          <li class="text-white/80">{city.name}</li>
        </ol>
      </nav>
      <div class="inline-flex items-center gap-3 mb-4">
        <span class="h-px w-8 bg-[#E10600]"></span>
        <span class="text-xs font-medium uppercase tracking-[0.24em] text-white/70">{city.state} · México</span>
      </div>
      <h1 class="font-sans font-black text-4xl leading-tight tracking-[-0.03em] text-white md:text-5xl lg:text-6xl max-w-3xl">
        SERVICIOS ELÉCTRICOS<br />DE MEDIA TENSIÓN EN<br /><span class="text-[#E10600]">{city.name.toUpperCase()}</span>
      </h1>
      <p class="mt-4 text-base text-white/75 max-w-xl leading-relaxed">
        Contratista eléctrico homologado CFE con presencia activa en {city.name}. Instalación MT, subestaciones y mantenimiento.
      </p>
    </div>
  </section>

  <!-- Intro + highlight -->
  <section class="bg-[#F3EFEA] py-14 md:py-20">
    <div class="mx-auto max-w-[1400px] px-6 md:px-10">
      <div class="grid grid-cols-1 gap-10 md:grid-cols-2 md:gap-16 items-start">
        <div>
          <div class="inline-flex items-center gap-3 mb-4">
            <span class="h-px w-8 bg-[#E10600]"></span>
            <span class="text-xs font-semibold uppercase tracking-[0.24em] text-[#E10600]">Cobertura local</span>
          </div>
          <h2 class="font-sans font-black text-3xl leading-tight tracking-[-0.02em] text-[#111] md:text-4xl">
            ¿POR QUÉ CENSA EN<br /><span class="text-[#E10600]">{city.name.toUpperCase()}?</span>
          </h2>
          <p class="mt-6 text-base leading-relaxed text-[#3a3a3a]">{city.intro}</p>
          <p class="mt-4 text-base leading-relaxed text-[#3a3a3a]">{city.highlight}</p>

          <ul class="mt-8 flex flex-col gap-3">
            {[
              `Respuesta de emergencia en menos de 2 horas en ${city.name}`,
              'Contratista homologado ante CFE · NOM-001-SEDE',
              '+15 años ejecutando proyectos en el noreste de México',
            ].map((item) => (
              <li class="flex items-center gap-3 text-sm text-[#3a3a3a]">
                <span class="grid h-5 w-5 shrink-0 place-items-center rounded-full bg-[#E10600] text-white">
                  <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20 6 9 17l-5-5"/>
                  </svg>
                </span>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-2 gap-4">
          {[
            { value: '+198', label: 'Proyectos ejecutados en NL' },
            { value: '<2h', label: 'Tiempo de respuesta emergencias' },
            { value: '+15', label: 'Años en el noreste de México' },
            { value: '24/7', label: 'Disponibilidad de cuadrillas' },
          ].map(({ value, label }) => (
            <div class="rounded-2xl border border-[#D8D2CC]/60 bg-white p-6">
              <p class="font-display text-4xl font-black tracking-tight text-[#E10600]">{value}</p>
              <p class="mt-1 text-xs text-[#6D6D6D] leading-snug">{label}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Servicios destacados -->
  <section class="bg-white py-14 md:py-20" aria-labelledby="city-services-heading">
    <div class="mx-auto max-w-[1400px] px-6 md:px-10">
      <div class="mb-10">
        <div class="inline-flex items-center gap-3 mb-4">
          <span class="h-px w-8 bg-[#E10600]"></span>
          <span class="text-xs font-semibold uppercase tracking-[0.24em] text-[#E10600]">Catálogo de servicios</span>
        </div>
        <h2 id="city-services-heading" class="font-sans font-black text-3xl leading-tight tracking-[-0.02em] text-[#111] md:text-4xl">
          SERVICIOS EN {city.name.toUpperCase()}
        </h2>
      </div>
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
        {featuredServices.map((s) => (
          <a
            href={`/servicios/${s.slug}`}
            class="group flex flex-col gap-4 rounded-2xl border border-[#D8D2CC]/60 bg-[#F3EFEA] p-6 transition-all hover:border-[#E10600]/40 hover:shadow-[0_4px_20px_-8px_rgba(225,6,0,0.15)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#E10600]"
          >
            <div class="grid h-11 w-11 place-items-center rounded-xl bg-[#E10600]/10 text-[#E10600] transition-colors group-hover:bg-[#E10600] group-hover:text-white">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={s.icon} aria-hidden="true" />
            </div>
            <div>
              <p class="text-[10px] font-semibold uppercase tracking-[0.18em] text-[#E10600]">Servicio {s.num}</p>
              <h3 class="mt-0.5 text-base font-bold text-[#111] group-hover:text-[#E10600] transition-colors">{s.title}</h3>
              <p class="mt-2 text-sm text-[#6D6D6D] leading-snug">{s.description}</p>
            </div>
            <span class="mt-auto text-xs font-semibold text-[#E10600] group-hover:underline">Ver detalles →</span>
          </a>
        ))}
      </div>
      <div class="mt-8 text-center">
        <a href="/servicios" class="text-sm font-semibold text-[#6D6D6D] hover:text-[#E10600] transition-colors">
          Ver catálogo completo de servicios →
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-[#E10600] py-14 md:py-20">
    <div class="mx-auto max-w-[1400px] px-6 md:px-10 text-center">
      <h2 class="font-sans font-black text-3xl text-white md:text-4xl">
        ¿PROYECTO ELÉCTRICO EN {city.name.toUpperCase()}?
      </h2>
      <p class="mt-4 text-white/80 max-w-xl mx-auto text-base">
        Evaluación técnica sin costo y propuesta en 48 horas hábiles. Cuadrillas disponibles en {city.name} ahora.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row justify-center">
        <a
          href="/contacto"
          class="inline-flex items-center justify-center gap-2 rounded-full bg-white px-8 py-4 text-sm font-semibold text-[#E10600] transition-all hover:bg-[#F3EFEA] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-[#E10600]"
        >
          Solicitar cotización
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
          </svg>
        </a>
        <a
          href="tel:+528122358545"
          class="inline-flex items-center justify-center gap-2 rounded-full border border-white/40 px-8 py-4 text-sm font-semibold text-white transition-all hover:bg-white/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.77 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 17z"/>
          </svg>
          Llamar ahora
        </a>
      </div>
    </div>
  </section>
</Layout>
