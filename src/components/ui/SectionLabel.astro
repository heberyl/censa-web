---
interface Props {
  label: string;
  class?: string;
}
const { label, class: extraClass = '' } = Astro.props;
---

<div class:list={['inline-flex items-center gap-3', extraClass]}>
  <span class="h-px w-10 bg-[#E10600]"></span>
  <span class="text-xs font-semibold uppercase tracking-[0.24em] text-[#E10600]">{label}</span>
</div>
