---
const year = new Date().getFullYear();

// NAP canónico — usar siempre estos valores en toda la app
export const NAP = {
  phone: '+52 81 2235-8545',
  phoneTel: '+528122358545',
  whatsapp: '528122358545',
  email: 'admon@censa.mx',
  address: 'San Isaac 1201, Residencial San Cristobal 3er Sector, C.P. 66478, San Nicolás de los Garza, N.L.',
};

const services = [
  { label: 'Instalación MT', href: '/servicios/instalacion-mt' },
  { label: 'Mantenimiento Preventivo', href: '/servicios/mantenimiento-preventivo' },
  { label: 'Subestaciones Eléctricas', href: '/servicios/subestaciones-electricas' },
  { label: 'Emergencias 24/7', href: '/servicios/emergencias-24-7' },
  { label: 'Ingeniería Eléctrica', href: '/servicios/ingenieria-electrica' },
];

const links = [
  { label: 'Inicio', href: '/' },
  { label: 'Nosotros', href: '/nosotros' },
  { label: 'Proyectos', href: '/proyectos' },
  { label: 'Contacto', href: '/contacto' },
];
---

<footer class="bg-[#111] text-white">
  <div class="mx-auto max-w-[1400px] px-6 md:px-10 pt-16 pb-10">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-4">

      <!-- Brand + redes -->
      <div class="lg:col-span-2">
        <a href="/" class="flex items-center gap-2 w-fit" aria-label="CENSA — Inicio">
          <span class="grid h-9 w-9 place-items-center rounded-md bg-[#E10600] text-white">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"/>
            </svg>
          </span>
          <span class="font-display text-3xl tracking-[0.18em] text-white">CENSA</span>
        </a>
        <p class="mt-4 text-sm leading-relaxed text-white/60 max-w-xs">
          Especialistas en infraestructura eléctrica de media tensión para la industria del noreste de México. Homologados CFE · NOM-001-SEDE.
        </p>

        <!-- Redes sociales -->
        <div class="mt-6 flex items-center gap-3">
          <a
            href="https://www.linkedin.com/company/censa-mx"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="CENSA en LinkedIn"
            class="grid h-9 w-9 place-items-center rounded-full border border-white/15 text-white/50 transition-all hover:border-[#E10600] hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#E10600]"
          >
            <!-- LinkedIn icon -->
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>
            </svg>
          </a>
          <a
            href={`https://wa.me/${NAP.whatsapp}?text=Hola%20CENSA%2C%20quisiera%20solicitar%20una%20cotizaci%C3%B3n.`}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Contactar CENSA por WhatsApp"
            class="grid h-9 w-9 place-items-center rounded-full border border-white/15 text-white/50 transition-all hover:border-[#25D366] hover:text-[#25D366] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#25D366]"
          >
            <!-- WhatsApp icon -->
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
            </svg>
          </a>
        </div>

        <div class="mt-6 flex items-center gap-2">
          <span class="h-2 w-2 rounded-full bg-[#E10600] shadow-[0_0_8px_#E10600]"></span>
          <span class="text-xs font-medium text-white/50 uppercase tracking-[0.18em]">Nuevo León, México</span>
        </div>
      </div>

      <!-- Servicios -->
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-white/40 mb-4">Servicios</p>
        <ul class="flex flex-col gap-2">
          {services.map(({ label, href }) => (
            <li>
              <a href={href} class="text-sm text-white/70 hover:text-[#E10600] transition-colors focus-visible:outline-none focus-visible:text-[#E10600]">
                {label}
              </a>
            </li>
          ))}
        </ul>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-white/40 mb-4 mt-8">Empresa</p>
        <ul class="flex flex-col gap-2">
          {links.map(({ label, href }) => (
            <li>
              <a href={href} class="text-sm text-white/70 hover:text-[#E10600] transition-colors focus-visible:outline-none focus-visible:text-[#E10600]">
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contacto — NAP canónico -->
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-white/40 mb-4">Contacto</p>
        <address class="not-italic flex flex-col gap-3 text-sm text-white/70">
          <div class="flex items-start gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0 text-[#E10600]" aria-hidden="true">
              <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/>
            </svg>
            <span>{NAP.address}</span>
          </div>
          <div class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-[#E10600]" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.77 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 17z"/>
            </svg>
            <a href={`tel:${NAP.phoneTel}`} class="hover:text-[#E10600] transition-colors">{NAP.phone}</a>
          </div>
          <div class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="shrink-0 text-[#25D366]" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
            </svg>
            <a href={`https://wa.me/${NAP.whatsapp}`} target="_blank" rel="noopener noreferrer" class="hover:text-[#25D366] transition-colors">WhatsApp directo</a>
          </div>
          <div class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-[#E10600]" aria-hidden="true">
              <rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
            <a href={`mailto:${NAP.email}`} class="hover:text-[#E10600] transition-colors">{NAP.email}</a>
          </div>
        </address>
        <a
          href="/contacto"
          class="mt-6 inline-flex items-center gap-2 rounded-full border border-white/20 px-5 py-2.5 text-xs font-semibold text-white transition-all hover:bg-[#E10600] hover:border-[#E10600] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#E10600]"
        >
          Solicitar cotización
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-12 pt-6 border-t border-white/10 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-xs text-white/30">
        &copy; {year} CENSA. Todos los derechos reservados.
      </p>
      <div class="flex items-center gap-6 flex-wrap">
        <a href="/aviso-de-privacidad" class="text-xs text-white/30 hover:text-white/60 transition-colors focus-visible:outline-none focus-visible:text-white/60">Aviso de privacidad</a>
        <span class="text-white/15 text-xs" aria-hidden="true">·</span>
        <span class="text-xs text-white/20 uppercase tracking-widest">CFE · NOM-001-SEDE</span>
      </div>
    </div>
  </div>
</footer>
