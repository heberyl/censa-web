---
const navLinks = [
  { href: '/nosotros', label: 'Nosotros' },
  { href: '/servicios', label: 'Servicios' },
  { href: '/proyectos', label: 'Proyectos' },
  { href: '/contacto', label: 'Contacto' },
];

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header
  id="site-header"
  class="sticky top-0 z-50 border-b border-[#D8D2CC]/60 backdrop-blur-md bg-white/95 transition-[box-shadow] duration-300"
>
  <div
    id="header-inner"
    class="mx-auto flex max-w-[1400px] items-center justify-between px-5 sm:px-6 md:px-10 transition-[height] duration-300 ease-out h-16 md:h-20"
  >
    <!-- Logo -->
    <a
      href="/"
      class="flex shrink-0 items-center gap-2 rounded-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#E10600]"
      aria-label="CENSA — Inicio"
    >
      <span class="grid h-9 w-9 place-items-center rounded-md bg-[#E10600] text-white">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"/>
        </svg>
      </span>
      <span class="font-display text-3xl tracking-[0.18em] text-[#111]">CENSA</span>
    </a>

    <!-- Desktop nav -->
    <nav aria-label="Navegación principal" class="hidden items-center gap-7 md:flex">
      {navLinks.map(({ href, label }) => {
        const isActive = pathname.startsWith(href);
        return (
          <a
            href={href}
            aria-current={isActive ? 'page' : undefined}
            class:list={[
              'relative py-1 text-sm font-medium transition-colors hover:text-[#E10600] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#E10600] rounded-sm',
              isActive ? 'text-[#E10600]' : 'text-[#111]',
            ]}
          >
            {label}
            {isActive && (
              <span
                class="absolute -bottom-0.5 left-0 right-0 h-[2px] rounded-full bg-[#E10600]"
                aria-hidden="true"
              />
            )}
          </a>
        );
      })}
    </nav>

    <div class="flex items-center gap-3 md:gap-4">
      <!-- Phone (desktop only) -->
      <a
        href="tel:+528122358545"
        class="hidden items-center gap-1.5 text-sm font-medium text-[#3a3a3a] transition-colors hover:text-[#E10600] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#E10600] rounded-sm lg:flex"
        aria-label="Llamar a CENSA: 81 2235-8545"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2.18h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6.16 6.16l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 17.92z"/>
        </svg>
        <span>81 2235-8545</span>
      </a>

      <!-- Divider (desktop) -->
      <span class="hidden lg:block h-5 w-px bg-[#D8D2CC]" aria-hidden="true"></span>

      <!-- CTA button -->
      <a
        href="/contacto"
        class="group inline-flex items-center gap-2 rounded-full bg-[#E10600] px-4 py-2.5 text-xs font-semibold text-white shadow-[0_8px_24px_-8px_rgba(225,6,0,0.5)] transition-all hover:bg-[#B30500] hover:shadow-[0_12px_28px_-8px_rgba(225,6,0,0.65)] sm:px-5 md:px-6 md:py-3 md:text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#E10600] focus-visible:ring-offset-2"
      >
        <span class="hidden sm:inline">Solicitar Cotización</span>
        <span class="sm:hidden">Cotizar</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">
          <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
        </svg>
      </a>

      <!-- Mobile hamburger -->
      <button
        id="mobile-menu-trigger"
        type="button"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="grid h-11 w-11 shrink-0 place-items-center rounded-full border border-[#D8D2CC] bg-white text-[#111] transition-colors hover:border-[#E10600] hover:text-[#E10600] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#E10600] md:hidden"
      >
        <svg id="icon-menu" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 5h16"/><path d="M4 12h16"/><path d="M4 19h16"/>
        </svg>
        <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="hidden">
          <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile menu drawer -->
<div
  id="mobile-menu"
  role="dialog"
  aria-label="Menú de navegación"
  aria-modal="true"
  class="fixed inset-0 z-40 hidden"
>
  <!-- Backdrop -->
  <div id="mobile-backdrop" class="absolute inset-0 bg-black/40 backdrop-blur-sm opacity-0 transition-opacity duration-300"></div>

  <!-- Drawer -->
  <nav
    aria-label="Navegación móvil"
    class="absolute right-0 top-0 h-full w-72 bg-white translate-x-full transition-transform duration-300 ease-out shadow-2xl flex flex-col px-6 pt-8 gap-1"
  >
    <!-- Close button inside drawer -->
    <div class="flex items-center justify-between mb-6">
      <span class="font-display text-xl tracking-[0.18em] text-[#111]">MENÚ</span>
      <button
        id="mobile-menu-close"
        type="button"
        aria-label="Cerrar menú"
        class="grid h-10 w-10 place-items-center rounded-full border border-[#D8D2CC] text-[#111] transition-colors hover:border-[#E10600] hover:text-[#E10600] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#E10600]"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
        </svg>
      </button>
    </div>

    {navLinks.map(({ href, label }) => {
      const isActive = pathname.startsWith(href);
      return (
        <a
          href={href}
          aria-current={isActive ? 'page' : undefined}
          class:list={[
            'mobile-nav-link flex items-center gap-3 text-base font-semibold py-3.5 border-b border-[#D8D2CC]/50 transition-colors hover:text-[#E10600] focus-visible:outline-none focus-visible:text-[#E10600]',
            isActive ? 'text-[#E10600]' : 'text-[#111]',
          ]}
        >
          {isActive && <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-[#E10600]" aria-hidden="true" />}
          {label}
        </a>
      );
    })}

    <a
      href="/contacto"
      class="mt-6 inline-flex items-center justify-center gap-2 rounded-full bg-[#E10600] px-6 py-3 text-sm font-semibold text-white transition-all hover:bg-[#B30500]"
    >
      Solicitar Cotización
    </a>

    <!-- Phone in drawer -->
    <a
      href="tel:+528122358545"
      class="mt-4 flex items-center justify-center gap-2 text-sm text-[#6D6D6D] hover:text-[#E10600] transition-colors"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2.18h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6.16 6.16l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 17.92z"/>
      </svg>
      81 2235-8545
    </a>
  </nav>
</div>

<style is:global>
  /* Scroll-aware header height */
  #header-inner {
    height: 4rem; /* h-16 = 64px mobile */
  }
  @media (min-width: 768px) {
    #header-inner {
      height: 5rem; /* h-20 = 80px desktop */
    }
  }
  #site-header[data-scrolled] #header-inner {
    height: 3.5rem; /* 56px compacto al hacer scroll */
  }
  @media (min-width: 768px) {
    #site-header[data-scrolled] #header-inner {
      height: 3.5rem;
    }
  }
  /* Scroll-aware shadow */
  #site-header[data-scrolled] {
    box-shadow: 0 4px 20px -4px rgba(0, 0, 0, 0.12);
    border-bottom-color: rgba(216, 210, 204, 0.9);
  }
</style>

<script>
  // Limpiadores de listeners a nivel document/window que sobreviven al swap del DOM.
  // Se actualizan en cada initHeader() para evitar acumulación entre navegaciones.
  let cleanScrollHandler: (() => void) | null = null;
  let cleanKeyHandler: (() => void) | null = null;

  function initHeader() {
    // 1. Limpiar listeners document/window de la página anterior
    cleanScrollHandler?.();
    cleanKeyHandler?.();

    // 2. Resetear overflow por si el menú estaba abierto al navegar
    document.body.style.overflow = '';

    // 3. Referencias frescas al DOM de la nueva página
    const trigger = document.getElementById('mobile-menu-trigger');
    const closeBtn = document.getElementById('mobile-menu-close');
    const menu = document.getElementById('mobile-menu');
    const backdrop = document.getElementById('mobile-backdrop');
    const drawer = menu?.querySelector('nav');
    const iconMenu = document.getElementById('icon-menu');
    const iconClose = document.getElementById('icon-close');
    const header = document.getElementById('site-header');

    if (!trigger || !closeBtn || !menu || !backdrop || !drawer || !iconMenu || !iconClose) return;

    let isOpen = false;

    function openMenu() {
      isOpen = true;
      menu.classList.remove('hidden');
      requestAnimationFrame(() => {
        backdrop.classList.remove('opacity-0');
        drawer.classList.remove('translate-x-full');
      });
      trigger.setAttribute('aria-expanded', 'true');
      iconMenu.classList.add('hidden');
      iconClose.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      trigger.setAttribute('aria-label', 'Cerrar menú de navegación');
    }

    function closeMenu() {
      isOpen = false;
      backdrop.classList.add('opacity-0');
      drawer.classList.add('translate-x-full');
      setTimeout(() => menu.classList.add('hidden'), 300);
      trigger.setAttribute('aria-expanded', 'false');
      iconMenu.classList.remove('hidden');
      iconClose.classList.add('hidden');
      document.body.style.overflow = '';
      trigger.setAttribute('aria-label', 'Abrir menú de navegación');
    }

    // Listeners en elementos del DOM (se recrea el DOM en cada nav → no hay acumulación)
    trigger.addEventListener('click', () => (isOpen ? closeMenu() : openMenu()));
    closeBtn.addEventListener('click', closeMenu);
    backdrop.addEventListener('click', closeMenu);
    document.querySelectorAll('.mobile-nav-link').forEach((link) =>
      link.addEventListener('click', closeMenu)
    );

    // ESC — listener en document, necesita limpieza explícita
    const keydownHandler = (e: KeyboardEvent) => {
      if (e.key === 'Escape' && isOpen) closeMenu();
    };
    document.addEventListener('keydown', keydownHandler);
    cleanKeyHandler = () => document.removeEventListener('keydown', keydownHandler);

    // Scroll-aware header — listener en window, necesita limpieza explícita
    if (header) {
      const scrollHandler = () => header.toggleAttribute('data-scrolled', window.scrollY > 30);
      window.addEventListener('scroll', scrollHandler, { passive: true });
      cleanScrollHandler = () => window.removeEventListener('scroll', scrollHandler);
      scrollHandler(); // ejecutar inmediatamente si la página ya tiene scroll
    }
  }

  // Corre en carga inicial Y después de cada View Transition
  document.addEventListener('astro:page-load', initHeader);
</script>
