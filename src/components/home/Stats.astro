---
const stats = [
  {
    value: '+15',
    label: 'Años de experiencia',
    detail: 'Operando infraestructura crítica para la industria regiomontana sin interrupciones.',
  },
  {
    value: '+198',
    label: 'Proyectos completados',
    detail: 'Subestaciones, líneas MT y mantenimientos entregados llave en mano.',
  },
  {
    value: '24/7',
    label: 'Atención de emergencias',
    detail: 'Cuadrillas certificadas listas para responder en menos de 2 horas.',
  },
  {
    value: '99%',
    label: 'Cumplimiento normativo',
    detail: 'Cumplimos CFE, NOM-001-SEDE y protocolos internos de seguridad.',
  },
];
---

<section class="bg-white" aria-label="Indicadores de desempeño">
  <div class="mx-auto grid max-w-[1400px] grid-cols-2 gap-px bg-[#D8D2CC]/50 md:grid-cols-4">
    {stats.map(({ value, label, detail }) => (
      <div class="group h-48 bg-white [perspective:1200px] md:h-64">
        <div
          class="relative h-full w-full transition-transform duration-700 ease-out [transform-style:preserve-3d] group-hover:[transform:rotateY(180deg)]"
        >
          <!-- Front -->
          <div class="absolute inset-0 flex flex-col items-center justify-center bg-white px-4 py-10 text-center [backface-visibility:hidden] md:px-6 md:py-14">
            <div class="font-sans font-black text-4xl leading-none tracking-tight text-[#111] md:text-6xl">
              {value}
            </div>
            <div class="mx-auto mt-3 h-px w-10 bg-[#E10600] md:mt-4"></div>
            <p class="mt-3 text-[10px] font-medium uppercase tracking-[0.12em] text-[#6D6D6D] md:mt-4 md:text-sm">
              {label}
            </p>
          </div>

          <!-- Back -->
          <div class="absolute inset-0 flex flex-col items-center justify-center bg-[#E10600] px-4 py-8 text-center text-white [backface-visibility:hidden] [transform:rotateY(180deg)] md:px-6 md:py-10">
            <div class="text-[10px] font-semibold uppercase tracking-[0.2em] text-white/85 md:text-xs">
              {label}
            </div>
            <div class="mx-auto mt-3 h-px w-10 bg-white/70"></div>
            <p class="mt-3 text-xs leading-relaxed text-white md:mt-4 md:text-sm">
              {detail}
            </p>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
