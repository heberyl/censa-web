---
import SectionLabel from '../ui/SectionLabel.astro';

const phases = [
  {
    num: '01',
    title: 'Evaluación',
    description: 'Diagnóstico técnico en sitio, levantamiento de cargas, estudio de la instalación existente y análisis de riesgos normativos.',
    image: '/images/fase-1-evaluacion.jpg',
    alt: 'Ingenieros evaluando instalación eléctrica industrial en campo',
  },
  {
    num: '02',
    title: 'Ingeniería',
    description: 'Diseño de la solución: planos unilineales, memorias de cálculo, selección de equipos y presentación de ingeniería básica y de detalle.',
    image: '/images/fase-2-ingenieria.jpg',
    alt: 'Ingenieros diseñando planos eléctricos en oficina',
  },
  {
    num: '03',
    title: 'Ejecución',
    description: 'Instalación por cuadrillas certificadas, suministro de materiales de primera línea, supervisión técnica y cumplimiento de protocolos de seguridad.',
    image: '/images/fase-3-ejecucion.jpg',
    alt: 'Cuadrilla instalando equipos en subestación eléctrica industrial',
  },
  {
    num: '04',
    title: 'Entrega',
    description: 'Pruebas de puesta en marcha, documentación as-built, capacitación al personal del cliente y garantía documental con reporte fotográfico.',
    image: '/images/fase-4-entrega.jpg',
    alt: 'Entrega de proyecto eléctrico concluido con documentación técnica',
  },
];
---

<section class="bg-[#F3EFEA] py-16 md:py-20" aria-labelledby="proceso-heading">
  <div class="mx-auto max-w-[1400px] px-6 md:px-10">
    <div class="mb-10 md:mb-12 reveal">
      <SectionLabel label="Nuestro Proceso" />
      <h2 id="proceso-heading" class="mt-6 font-sans font-black text-4xl leading-[0.95] tracking-[-0.02em] text-[#111] md:text-5xl">
        4 FASES<br /><span class="text-[#E10600]">PROBADAS</span>
      </h2>
    </div>

    <!-- Contenedor relativo para la línea conectora -->
    <div class="relative">
      <!-- Línea conectora — solo desktop lg+ -->
      <div
        id="process-line"
        class="process-connector absolute hidden lg:block top-[88px] left-[12%] right-[12%] h-0.5 bg-[#E10600] z-10 pointer-events-none"
        aria-hidden="true"
      ></div>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4 reveal-stagger">
        {phases.map(({ num, title, description, image, alt }) => (
          <div class="group relative overflow-hidden rounded-2xl bg-white border border-[#D8D2CC]/60 shadow-[0_2px_16px_-8px_rgba(0,0,0,0.08)]">
            <!-- Image -->
            <div class="relative h-36 md:h-44 overflow-hidden">
              <img
                src={image}
                alt={alt}
                width="600"
                height="400"
                class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
                decoding="async"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
              <!-- Número con círculo blanco para destacar sobre la línea -->
              <div class="absolute left-4 bottom-4 flex items-center justify-center h-10 w-10 rounded-full bg-[#E10600] shadow-lg z-20">
                <span class="font-display text-lg text-white leading-none" aria-hidden="true">{num}</span>
              </div>
            </div>

            <!-- Content -->
            <div class="p-5 md:p-6">
              <div class="mb-3 h-px w-8 bg-[#E10600]"></div>
              <h3 class="font-sans font-black text-xl text-[#111] tracking-tight">
                FASE {num}: {title.toUpperCase()}
              </h3>
              <p class="mt-3 text-sm leading-relaxed text-[#6D6D6D]">
                {description}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const line = document.getElementById('process-line');
  if (line) {
    const obs = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          line.classList.add('in-view');
          obs.disconnect();
        }
      },
      { threshold: 0.3 }
    );
    obs.observe(line);
  }
</script>
