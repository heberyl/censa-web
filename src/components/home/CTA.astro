<section class="bg-[#E10600] py-16 md:py-24" aria-labelledby="cta-heading">
  <div class="mx-auto max-w-[1400px] px-6 md:px-10">
    <div class="flex flex-col gap-8 md:flex-row md:items-center md:justify-between">
      <div class="max-w-xl">
        <div class="inline-flex items-center gap-3 mb-4">
          <span class="h-px w-8 bg-white/50"></span>
          <span class="text-xs font-semibold uppercase tracking-[0.24em] text-white/80">Comenzar un proyecto</span>
        </div>
        <h2 id="cta-heading" class="font-sans font-black text-3xl leading-tight tracking-[-0.02em] text-white md:text-4xl lg:text-5xl">
          ¿LISTO PARA UNA<br />INFRAESTRUCTURA<br />QUE NO FALLA?
        </h2>
        <p class="mt-4 text-base text-white/80 leading-relaxed md:text-lg">
          Hablemos de tu proyecto. Evaluación sin costo, propuesta técnica y cotización en 48 horas.
        </p>
      </div>
      <div class="flex flex-col gap-3 shrink-0 sm:flex-row md:flex-col lg:flex-row">
        <a
          href="/contacto"
          class="inline-flex items-center justify-center gap-2 rounded-full bg-white px-8 py-4 text-sm font-semibold text-[#E10600] shadow-[0_12px_32px_-8px_rgba(0,0,0,0.3)] transition-all hover:bg-[#F3EFEA] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-[#E10600]"
        >
          Solicitar Cotización
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
          </svg>
        </a>
        <a
          href="tel:+528100000000"
          class="inline-flex items-center justify-center gap-2 rounded-full border border-white/40 px-8 py-4 text-sm font-semibold text-white transition-all hover:bg-white/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.77 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 17z"/>
